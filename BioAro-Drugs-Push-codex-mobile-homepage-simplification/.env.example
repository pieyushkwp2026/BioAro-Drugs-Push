# BioAro frontend runtime configuration
# Copy this file to .env.local for local development.

# Shopify Storefront API
VITE_SHOPIFY_DOMAIN=your-store.myshopify.com
VITE_SHOPIFY_STOREFRONT_TOKEN=your_public_storefront_token

# Shopify Admin API
# These values are for secure scripts or backend jobs only. Do not expose them in browser code.
SHOPIFY_ADMIN_SHOP_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_xxx
SHOPIFY_ADMIN_API_VERSION=2026-07

# Optional: keep preview catalog/cart fallback enabled.
# Set to "false" once Shopify products, carts, and market pricing are ready.
VITE_SHOPIFY_USE_MOCK_DATA=true
# Optional: the published Shopify product handle for BioAro Drugs AI Membership.
# The frontend shows a non-misleading unavailable state until this and a selling plan exist.
VITE_SHOPIFY_MEMBERSHIP_HANDLE=bioaro-drugs-ai-membership
VITE_MEMBERSHIP_CHECKOUT_API_ENABLED=false

# Optional: external Geo-IP/bootstrap endpoint.
# Expected JSON shape:
# {
#   "country": "US" | "CA" | "GB",
#   "currency": "USD" | "CAD" | "GBP",
#   "experienceRegion": "NA" | "UK"
# }
VITE_MARKET_BOOTSTRAP_URL=

# --- Member dashboard -------------------------------------------------------
# The member endpoint does not exist yet. Leave false; the dashboard renders
# honest empty states without it.
VITE_MEMBER_API_ENABLED=false

# Local and preview only. Renders clearly marked demonstration data in the member
# dashboard so the shape of the platform can be reviewed before it is built.
# Ignored entirely on the production hostname - see src/lib/member/demoMode.ts.
VITE_MEMBER_DEMO_DATA=false
