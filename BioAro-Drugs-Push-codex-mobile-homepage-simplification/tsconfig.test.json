{
  "compilerOptions": {
    "target": "ES2023",
    "module": "commonjs",
    "moduleResolution": "node",
    "rootDir": ".",
    "outDir": "./.test-dist",
    "types": [
      "node"
    ],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "src/lib/routes.ts",
    "src/lib/market/types.ts",
    "src/lib/market/config.ts",
    "src/lib/market/resolve.ts",
    "src/lib/shopify/types.ts",
    "src/lib/shopify/productMapping.ts",
    "src/lib/content/types.ts",
    "src/data/siteContent.ts",
    "src/lib/ask/types.ts",
    "src/lib/ask/safety.ts",
    "src/lib/ask/match.ts",
    "src/lib/product/amount.ts",
    "src/lib/protocol/build.ts",
    "src/lib/protocol/session.ts",
    "src/lib/protocol/questions.ts",
    "src/data/homepage.ts",
    "src/lib/ai/matchGoals.ts",
    "src/config/markets/types.ts",
    "src/config/markets/index.ts",
    "src/lib/member/types.ts",
    "src/lib/member/capabilities.ts",
    "src/lib/member/demoSnapshot.ts",
    "src/lib/assistant/turns.ts",
    "src/lib/assistant/skills.ts",
    "src/lib/assistant/history.ts",
    "tests/**/*.ts"
  ]
}
