{
  "name": "bioaro-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "CHOKIDAR_USEPOLLING=true CHOKIDAR_INTERVAL=300 vite --host 127.0.0.1 --port 5173",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview --host 127.0.0.1 --port 5173",
    "test": "tsc -p tsconfig.test.json && printf '{\"type\":\"commonjs\"}' > .test-dist/package.json && node --test .test-dist/tests/*.test.js",
    "shopify:pdp:dry-run": "node scripts/shopify-pdp-rollout.mjs --dry-run",
    "shopify:pdp:glossary:dry-run": "node --env-file=.env.local scripts/shopify-pdp-glossary-import.mjs",
    "shopify:pdp:glossary:workbook-only": "node scripts/shopify-pdp-glossary-import.mjs --workbook-only",
    "shopify:pdp:glossary:apply": "node --env-file=.env.local scripts/shopify-pdp-glossary-import.mjs --apply --confirm-workbook-import",
    "shopify:pdp:definitions": "node scripts/shopify-pdp-rollout.mjs --create-definitions",
    "shopify:catalogue:dry-run": "node scripts/shopify-catalogue-dry-run.mjs",
    "shopify:catalogue:import-preview": "node scripts/shopify-catalogue-import-preview.mjs",
    "shopify:catalogue:apply": "node scripts/shopify-catalogue-apply.mjs",
    "shopify:audit": "node --env-file=.env.local scripts/shopify-source-of-truth-audit.mjs"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.2",
    "oxlint": "^1.71.0",
    "postcss": "^8.5.16",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
